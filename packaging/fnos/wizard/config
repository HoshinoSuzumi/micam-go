[
  {
    "stepTitle": "小米账号",
    "items": [
      {
        "type": "tips",
        "helpText": "userId 和 passToken 只能从浏览器 Cookie 里取：登录 account.xiaomi.com → 按 F12 → Application → Cookies。应用的首页有逐步截图说明。两者都填错会导致登录失败，userId 是纯数字，不是手机号。"
      },
      {
        "type": "text",
        "field": "wizard_user",
        "label": "账号（uid / 手机 / 邮箱）",
        "initValue": "",
        "rules": [
          { "required": true, "message": "请填写小米账号" }
        ]
      },
      {
        "type": "text",
        "field": "wizard_user_id",
        "label": "数字 userId（用 passToken 登录时必填）",
        "initValue": "",
        "helpText": "浏览器登录 account.xiaomi.com 后，在 DevTools → Application → Cookies 里取 userId"
      },
      {
        "type": "select",
        "field": "wizard_region",
        "label": "账号区域",
        "initValue": "cn",
        "options": [
          { "label": "中国大陆 (cn)", "value": "cn" },
          { "label": "德国 (de)", "value": "de" },
          { "label": "新加坡 (sg)", "value": "sg" },
          { "label": "美国 (us)", "value": "us" },
          { "label": "俄罗斯 (ru)", "value": "ru" },
          { "label": "印度 (i2)", "value": "i2" }
        ]
      },
      {
        "type": "password",
        "field": "wizard_pass_token",
        "label": "passToken",
        "initValue": "",
        "rules": [
          { "required": true, "message": "请粘贴 passToken" }
        ]
      },
      {
        "type": "tips",
        "helpText": "passToken 等同账号密码：它能让持有者访问你账号下的设备。应用只把它存在 NAS 本地（0600），但请不要贴到聊天群或提交进仓库。密码登录常被二次验证拦住，而那个验证码绑定浏览器设备，所以这里只支持 passToken。"
      }
    ]
  },
  {
    "stepTitle": "摄像头与码流",
    "items": [
      {
        "type": "text",
        "field": "wizard_did",
        "label": "摄像头 DID",
        "initValue": "",
        "rules": [
          { "required": true, "message": "请填写 DID" },
          { "pattern": "^[0-9]+$", "message": "DID 是纯数字" }
        ]
      },
      {
        "type": "select",
        "field": "wizard_quality",
        "label": "清晰度",
        "initValue": "3",
        "options": [
          { "label": "3 全分辨率（推荐）", "value": "3" },
          { "label": "2 HD", "value": "2" },
          { "label": "1 SD", "value": "1" }
        ]
      },
      {
        "type": "select",
        "field": "wizard_lan",
        "label": "连接方式",
        "initValue": "prefer",
        "options": [
          { "label": "优先局域网，失败回落中继 (prefer)", "value": "prefer" },
          { "label": "只用局域网 (only)", "value": "only" },
          { "label": "只用中继 (off)", "value": "off" }
        ]
      },
      {
        "type": "text",
        "field": "wizard_pts_lead",
        "label": "画面提前量（毫秒）",
        "initValue": "100",
        "rules": [
          { "pattern": "^[0-9]+$", "message": "请填数字" }
        ]
      },
      {
        "type": "tips",
        "helpText": "保存后会重建容器。首次拉取镜像可能需要几分钟。"
      }
    ]
  }
]
