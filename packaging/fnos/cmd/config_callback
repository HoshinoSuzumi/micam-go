#!/bin/sh
# 配置变更后：把向导收集到的值写成配置文件，再重启服务。
#
# 文件格式（包括引号转义）只在 micam 里实现一次：界面走 /api/config，向导走
# write-config，两条路写出来的字节完全一样。
#
# 向导值来自同名字段：wizard_user / wizard_user_id / wizard_region /
# wizard_did / wizard_quality / wizard_lan / wizard_pts_lead / wizard_pass_token。
set -eu

APP="${TRIM_APPNAME:-micam}"
PKGETC="${TRIM_PKGETC:-/var/apps/$APP/etc}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/$APP/var}"
BIN="${TRIM_APPDEST:-/var/apps/$APP/target}/bin/micam"
HERE=$(cd "$(dirname "$0")" && pwd)

if ! "$BIN" write-config; then
    echo "配置校验失败，没有写入。检查 userId 是否为纯数字、DID 是否正确。" \
        >>"${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 1
fi

chmod 600 "$PKGETC/micam.env" "$PKGETC/pass_token" 2>/dev/null || true

if [ "$(id -u)" = 0 ] && [ -n "${TRIM_UID:-}" ]; then
    chown "$TRIM_UID:${TRIM_GID:-$TRIM_UID}" "$PKGETC/micam.env" "$PKGETC/pass_token" 2>/dev/null || true
    chown -R "$TRIM_UID:${TRIM_GID:-$TRIM_UID}" "$PKGVAR" 2>/dev/null || true
fi

# 配置变了就得换进程：只写文件的话，正在跑的那个还在用旧值。
"$HERE/main" stop || true

if [ -z "${wizard_did:-}" ]; then
    echo "缺少 DID，服务不会自动启动。" >>"${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 0
fi

"$HERE/main" start || true

exit 0
