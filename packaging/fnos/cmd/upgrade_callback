#!/bin/sh
# 升级后：迁移旧配置与凭据，然后按新配置重新启动。
#
# 配置和凭据都被保留，不需要重新登录。
set -eu

APP="${TRIM_APPNAME:-micam}"
PKGETC="${TRIM_PKGETC:-/var/apps/$APP/etc}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/$APP/var}"
HERE=$(cd "$(dirname "$0")" && pwd)

# 旧版本把监听地址、端口、token 路径写在 micam.env 里，现在由 cmd/main 决定。
if [ -f "$PKGETC/micam.env" ]; then
    sed -i.bak '/^MICAM_BIND=/d; /^MICAM_PORT=/d; /^MICAM_PASS_TOKEN_FILE=/d; /^MICAM_DATA_DIR=/d' \
        "$PKGETC/micam.env" 2>/dev/null || true
    rm -f "$PKGETC/micam.env.bak"
fi

# 容器版的凭据在 var/.micam。搬过来，别让用户为一晚上的流重新登录一次。
if [ -f "$PKGVAR/.micam/credentials.json" ] && [ ! -f "$PKGVAR/data/credentials.json" ]; then
    mkdir -p "$PKGVAR/data"
    cp -f "$PKGVAR/.micam/credentials.json" "$PKGVAR/data/credentials.json"
fi

# 旧容器已经不归这个包管了，但它还占着 8554。
if command -v docker >/dev/null 2>&1; then
    docker rm -f "$APP" >/dev/null 2>&1 || true
fi

# 会话缓存从 var/data 搬到「访问权限」里的共享目录（config/resource 的 data-share）。
# 只在目标还没有文件时搬，避免覆盖用户后来登录的那份。
share=$(printf '%s' "${TRIM_DATA_SHARE_PATHS:-}" | cut -d: -f1)
if [ -n "$share" ] && [ -f "$PKGVAR/data/credentials.json" ] && [ ! -f "$share/credentials.json" ]; then
    mkdir -p "$share" 2>/dev/null || true
    cp -f "$PKGVAR/data/credentials.json" "$share/credentials.json" 2>/dev/null || true
fi

"$HERE/main" start || true

exit 0
